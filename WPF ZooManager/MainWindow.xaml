<Window x:Class="WPF_ZooManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_ZooManager"
        mc:Ignorable="d"
        Title="Zoo Manager" Height="500" Width="725">
	<Grid>
		<Label Content="ZooList" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
		<ListBox Name="listZoos" Margin="10,54,572,201" SelectionChanged="listZoos_SelectionChanged"/>
		<Label Content="Associated Animals List&#xD;&#xA;" HorizontalAlignment="Left" Margin="205,10,0,0" VerticalAlignment="Top"/>
		<ListBox x:Name="listAssociatedAnimals" Margin="205,54,377,201"/>
		<ListBox x:Name="listAllAnimals" Margin="394,54,188,111" SelectionChanged="listAnimals_SelectionChanged"/>
		<Button Click="DeleteZoo_Click" Content="Delete Zoo" HorizontalAlignment="Left" Margin="10,296,0,0" VerticalAlignment="Top" Height="36" Width="143"/>
		<Button Content="Remove Animal" HorizontalAlignment="Left" Margin="205,296,0,0" VerticalAlignment="Top" Height="36" Width="143"/>
		<Button Click="UpdateAnimal_Click" Content="Update Animal" HorizontalAlignment="Left" Margin="205,419,0,0" VerticalAlignment="Top" Height="36" Width="143"/>
		<Button Click ="UpdateZoo_Click" Content="Update Zoo" HorizontalAlignment="Left" Margin="10,419,0,0" VerticalAlignment="Top" Height="36" Width="143"/>
		<Button Click="AddAnimal_Click" Content="Add Animal" HorizontalAlignment="Left" Margin="205,378,0,0" VerticalAlignment="Top" Height="36" Width="143"/>
		<Button Click="AddZoo_Click" Content="Add Zoo" HorizontalAlignment="Left" Margin="10,378,0,0" VerticalAlignment="Top" Height="36" Width="143"/>
		<Button Click="AddAnimalToZoo_Click" Content="Add Animal to Zoo" HorizontalAlignment="Left" Margin="394,10,0,0" VerticalAlignment="Top" Height="36" Width="143"/>
		<Button Click="DeleteAnimal_Click" Content="Delete Animal" HorizontalAlignment="Left" Margin="394,378,0,0" VerticalAlignment="Top" Height="36" Width="143"/>
		<TextBox Name="myTextBox" HorizontalAlignment="Left" Margin="10,337,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="338" Height="36"/>

	</Grid>
</Window>
